[Unit]
Description=Money Hub: WAL-safe SQLite snapshot
OnFailure=moneyhub-backup-fail.service

[Service]
Type=oneshot
User=moneyhub
Group=moneyhub
WorkingDirectory=/opt/moneyhub
ExecStart=/opt/moneyhub/.venv/bin/moneyhub snapshot --dest /var/backups/moneyhub --keep 14

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/backups/moneyhub
