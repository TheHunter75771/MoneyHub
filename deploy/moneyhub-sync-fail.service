[Unit]
Description=Money Hub: notify phone when the daily sync fails

[Service]
Type=oneshot
WorkingDirectory=/run/media/hunter/AI/Claude/Finances/money-hub
ExecStart=/run/media/hunter/AI/Claude/Finances/money-hub/.venv-host/bin/moneyhub notify \
  --title "Money Hub sync FAILED" \
  --message "The daily bank sync did not complete. Check: journalctl --user -u moneyhub-sync" \
  --priority high
