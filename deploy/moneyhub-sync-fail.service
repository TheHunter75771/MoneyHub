[Unit]
Description=Money Hub: notify phone when the daily sync fails

[Service]
Type=oneshot
User=moneyhub
Group=moneyhub
WorkingDirectory=/opt/moneyhub
EnvironmentFile=-/opt/moneyhub/.env
ExecStart=/opt/moneyhub/.venv/bin/moneyhub notify \
  --title "Money Hub sync FAILED" \
  --message "The daily bank sync did not complete. Check: journalctl -u moneyhub-sync" \
  --priority high
