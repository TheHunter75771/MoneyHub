[Unit]
Description=Money Hub: SimpleFIN sync + categorize + phone digest
After=network-online.target
Wants=network-online.target
OnFailure=moneyhub-sync-fail.service

[Service]
Type=oneshot
User=moneyhub
Group=moneyhub
WorkingDirectory=/opt/moneyhub
EnvironmentFile=-/opt/moneyhub/.env
ExecStart=/opt/moneyhub/.venv/bin/moneyhub sync
# Digest push after every successful sync; '-' so a push hiccup never
# marks the sync itself failed.
ExecStartPost=-/opt/moneyhub/.venv/bin/moneyhub notify

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
