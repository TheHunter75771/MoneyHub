[Unit]
Description=Money Hub: SimpleFIN sync + categorize
# Requires the drive holding the repo to be mounted.
ConditionPathExists=/run/media/hunter/AI/Claude/Finances/money-hub

[Service]
Type=oneshot
WorkingDirectory=/run/media/hunter/AI/Claude/Finances/money-hub
# .venv-host is built with the host's own python (see README); the dev
# .venv may belong to a different toolchain.
ExecStart=/run/media/hunter/AI/Claude/Finances/money-hub/.venv-host/bin/moneyhub sync
