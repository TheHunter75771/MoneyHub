[Unit]
Description=Money Hub web UI (Nocturne) + API
Documentation=https://github.com/TheHunter75771/MoneyHub
# The bind address is this host's Tailscale IP, which only exists once
# tailscaled is up. Restart=always + StartLimitIntervalSec=0 means a boot
# race just retries until the address appears instead of staying dead.
After=network-online.target tailscaled.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=moneyhub
Group=moneyhub
WorkingDirectory=/opt/moneyhub
EnvironmentFile=-/opt/moneyhub/.env
ExecStart=/opt/moneyhub/.venv/bin/moneyhub-web
Restart=always
RestartSec=5

# Hardening. /opt stays writable (the DB and .env live there); the rest of
# the system is read-only to this service.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
