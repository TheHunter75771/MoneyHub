# Money Hub runtime config. Copied to /opt/moneyhub/.env by deploy/install.sh
# (mode 600, owned by the moneyhub user). Never commit the real file.
#
# systemd loads this file into every unit's environment, and the app reads it
# again from the working directory, so one file configures both.

# Bind address for the web UI + API. install.sh fills in this host's
# Tailscale IPv4 so the app is reachable from the tailnet and nowhere else.
# The app has no auth by design: NEVER set this to 0.0.0.0 or a LAN address.
MONEYHUB_WEB_HOST=127.0.0.1
MONEYHUB_WEB_PORT=8710

# --- Live bank sync (SimpleFIN Bridge) ---------------------------------------
# Paste the one-time setup token from bridge.simplefin.org. The first
# `moneyhub sync` exchanges it for an access URL and appends that URL to
# this file as its own line; delete the setup token line afterwards.
SIMPLEFIN_SETUP_TOKEN=

# --- Phone notifications (ntfy) ----------------------------------------------
# The topic name IS the secret on ntfy.sh: generate it, never pick it.
#   openssl rand -hex 12 | sed 's/^/mh-/'
NTFY_TOPIC=

# --- Notion projection (optional, one-way) -----------------------------------
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
